#!/usr/bin/env php
<?php

declare(strict_types=1);

use Texstar\Exchange\Cli\App;

/**
 * Reference CLI of texstar/exchange-contract. See Texstar\Exchange\Cli\App for the commands:
 *
 *   exchange sync --from=nesc --to=pmo --from-url=… --to-url=… [--from-token=… --to-token=…] [--both] [--include-blobs] [--program=…]
 *   exchange push-updates <file.xlsx> --url=… [--token=…] [--dry-run] [--create]
 *   exchange fixtures:sign [--fixture=<name>] | fixtures:build <name> [--out=<zip>] | suite:run
 *   exchange schemas:audit | package:inspect <zip> [--keys=id=secret,…] [--max-unpacked-mb=N]
 */
foreach ([__DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new App)->run(array_slice($argv, 1)));
